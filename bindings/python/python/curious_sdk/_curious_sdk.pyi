from collections.abc import Awaitable
from decimal import Decimal
from typing import Literal, TypeAlias

_Value: TypeAlias = None | bool | int | Decimal | str | list["_Value"] | dict[str, "_Value"]
_Outcome: TypeAlias = Literal["unchanged", "missing_or_invalid_key", "failed", "decrypted"]

class CuriousError(Exception): ...

class HttpStatusError(CuriousError):
    status: int
    attempts: int

class Client:
    def __init__(self, base_url: str, bearer_token: str | None = None) -> None: ...
    @staticmethod
    def for_mock(
        base_url: str, bearer_token: str | None = None, *, prefer: str | None = None
    ) -> Client: ...
    def login(self, email: str, password: str) -> Awaitable[Client | MfaChallenge]: ...
    def list_applets(self, page: int = 1, page_size: int = 50) -> Awaitable[AppletPage]: ...
    def get_applet(self, id: str) -> Awaitable[Applet]: ...
    def lookup_applet_by_id(self, id: str) -> Awaitable[Applet]: ...
    def export_applet_data(
        self, id: str, *, from_date: str | None = None, page: int = 1, page_size: int = 50
    ) -> Awaitable[ExportPage]: ...

class MfaChallenge:
    @property
    def token(self) -> str: ...
    @property
    def session_id(self) -> str: ...
    @property
    def user_id(self) -> str: ...
    @property
    def user_email(self) -> str: ...

class Applet:
    @property
    def id(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def metadata(self) -> dict[str, _Value]: ...

class AppletPage:
    @property
    def applets(self) -> list[Applet]: ...
    @property
    def count(self) -> int | None: ...

class ExportPage:
    @property
    def answers(self) -> list[_Value]: ...
    @property
    def activities(self) -> list[_Value]: ...

class EncryptedData: ...

class DecryptedData:
    @property
    def answers(self) -> list[_Value]: ...
    @property
    def activities(self) -> list[_Value]: ...
    @property
    def outcomes(self) -> list[tuple[_Outcome, _Outcome]]: ...

def encrypted_data(page: ExportPage, applet: Applet) -> EncryptedData: ...
def decrypt(password: str, data: EncryptedData) -> Awaitable[DecryptedData]: ...
